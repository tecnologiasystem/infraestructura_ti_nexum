<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!-- Configuración para React Router (SPA) -->
    <rewrite>
      <rules>
        <!-- Regla para redireccionar todas las rutas al index.html -->
        <rule name="React Routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/(api)" negate="true" />
          </conditions>
          <action type="Rewrite" url="/" />
        </rule>

        <!-- Reverse Proxy para el Gateway -->
        <rule name="Gateway API" stopProcessing="true">
          <match url="^api/gateway/(.*)" />
          <action type="Rewrite" url="http://172.18.73.22:3002/gateway/{R:1}" />
        </rule>

        <!-- Reverse Proxy para Planeación -->
        <rule name="Planeacion API" stopProcessing="true">
          <match url="^api/planeacion/(.*)" />
          <action type="Rewrite" url="http://172.18.73.22:3002/api/planeacion/{R:1}" />
        </rule>

        <!-- Reverse Proxy para Notificaciones -->
        <rule name="Notificaciones API" stopProcessing="true">
          <match url="^api/notificaciones/(.*)" />
          <action type="Rewrite" url="http://172.18.73.22:3002/api/notificaciones/{R:1}" />
        </rule>

        <!-- Reverse Proxy para IA -->
        <rule name="IA API" stopProcessing="true">
          <match url="^api/ia/(.*)" />
          <action type="Rewrite" url="http://172.18.73.22:3002/api/ia/{R:1}" />
        </rule>

        <!-- Reverse Proxy para Login -->
        <rule name="Login API" stopProcessing="true">
          <match url="^api/login/(.*)" />
          <action type="Rewrite" url="http://172.18.73.76:3000/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <!-- Habilitar CORS si es necesario -->
    <httpProtocol>
      <customHeaders>
        <add name="Access-Control-Allow-Origin" value="*" />
        <add name="Access-Control-Allow-Methods" value="GET, POST, PUT, DELETE, OPTIONS" />
        <add name="Access-Control-Allow-Headers" value="Content-Type, Authorization" />
      </customHeaders>
    </httpProtocol>

    <!-- Configuración de tipos MIME -->
    <staticContent>
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <mimeMap fileExtension=".woff" mimeType="application/font-woff" />
      <mimeMap fileExtension=".woff2" mimeType="application/font-woff2" />
    </staticContent>

    <!-- Compresión para mejorar performance -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <!-- Configuración de errores personalizados -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
